# Copy to .env and edit. Everything here is optional; the defaults run anywhere
# with an NVIDIA GPU (≥16 GB for the fast modes, ≥12 GB for eager).

# Where the weights live (downloaded to $MODEL_DIR/breeze-tts-2 on first start).
# MODEL_DIR=./models
# Saved voices and other server output ($DATA_DIR/outputs/voices).
# DATA_DIR=./data

# BREEZE_PORT=8500
# full | graphs | eager | full+compile. scripts/pick-fast-mode.sh sets this for you.
# BREEZE_FAST_MODE=full
# BREEZE_MEM_LIMIT=28g
# 1 = upstream's plain API instead of ours (rollback).
# BREEZE_UPSTREAM=0

# Build: the container user's ids, so files in DATA_DIR / MODEL_DIR are yours.
# UID=1000
# GID=1000

# DGX Spark / GB10: big-core pinning, host networking, llama-swap label.
# COMPOSE_FILE=compose.yml:compose.gb10.yml
